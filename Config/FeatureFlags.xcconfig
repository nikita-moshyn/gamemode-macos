// Stable is the default for local/Xcode builds. CI explicitly selects the channel.
GAMEMODE_CHANNEL = stable
GAMEMODE_FLAGS_stable =
GAMEMODE_FLAGS_rc =
GAMEMODE_FLAGS_beta = GAMEMODE_BETA FEATURE_DISPLAYS
GAMEMODE_FEATURE_FLAGS = $(GAMEMODE_FLAGS_$(GAMEMODE_CHANNEL))
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(GAMEMODE_FEATURE_FLAGS)
